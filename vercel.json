{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/assets/images/Elanslogo.jpeg",
      "destination": "/assets/images/etw-logo.png",
      "permanent": true
    },
    {
      "source": "/pages/whyus.html",
      "destination": "/whyus/",
      "permanent": true
    },
    {
      "source": "/pages/services.html",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/pages/contact.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/pages/projects.html",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portfolio/index.html",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/portfolio/alpha-vital-elite-iv.html",
      "destination": "/portfolio/alpha-vital-elite-iv/",
      "permanent": true
    },
    {
      "source": "/portfolio/cohen-associates.html",
      "destination": "/portfolio/cohen-associates/",
      "permanent": true
    },
    {
      "source": "/portfolio/child-family-psychological-services.html",
      "destination": "/portfolio/child-family-psychological-services/",
      "permanent": true
    },
    {
      "source": "/portfolio/holistic-mental-health-services.html",
      "destination": "/portfolio/holistic-mental-health-services/",
      "permanent": true
    },
    {
      "source": "/portfolio/evia-aesthetics.html",
      "destination": "/portfolio/evia-aesthetics/",
      "permanent": true
    },
    {
      "source": "/portfolio/park-city-34.html",
      "destination": "/portfolio/park-city-34/",
      "permanent": true
    },
    {
      "source": "/portfolio/barber-world-nyc.html",
      "destination": "/portfolio/barber-world-nyc/",
      "permanent": true
    },
    {
      "source": "/portfolio/century-one-properties.html",
      "destination": "/portfolio/century-one-management/",
      "permanent": true
    },
    {
      "source": "/portfolio/doug-uhlig-psychological.html",
      "destination": "/portfolio/doug-uhlig-psychological/",
      "permanent": true
    },
    {
      "source": "/portfolio/east-coast-realty.html",
      "destination": "/portfolio/east-coast-realty/",
      "permanent": true
    },
    {
      "source": "/portfolio/five-star-laser.html",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/portfolio/iconic-aesthetics.html",
      "destination": "/portfolio/iconic-aesthetics/",
      "permanent": true
    },
    {
      "source": "/portfolio/lauras-beauty-touch.html",
      "destination": "/portfolio/lauras-beauty-touch/",
      "permanent": true
    },
    {
      "source": "/portfolio/nyc-panache-salon.html",
      "destination": "/portfolio/nyc-panache-salon/",
      "permanent": true
    },
    {
      "source": "/portfolio/s-cream.html",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/portfolio/century-one-properties",
      "destination": "/portfolio/century-one-management/",
      "permanent": true
    },
    {
      "source": "/portfolio/five-star-laser",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/portfolio/s-cream",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/auth",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/callback",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/sitemap-portfolio.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/portfolio/century-one-properties/",
      "destination": "/portfolio/century-one-management/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(scripts|data)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
